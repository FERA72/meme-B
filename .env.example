# PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/memebeta

# Helius API Key (get from helius.dev)
HELIUS_API_KEY=your_helius_api_key_here

# Webhook Server Settings
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5000

# Filter Thresholds (Anti-Rug Checks)
MIN_LIQUIDITY_USD=20000
MAX_TOP_HOLDER_PCT=40
MIN_HOLDER_COUNT=10

# Graduation Thresholds
MIN_LIQUIDITY_GROWTH=2.0
MIN_MARKET_CAP=100000
MIN_HOLDER_GROWTH=1.5
MIN_VOLUME_24H=10000
GRADUATION_CHECK_INTERVAL=60

# Background refresher (seconds between whitelist refresh cycles)
REFRESH_INTERVAL_SECONDS=120

# GPT scoring (optional)
ENABLE_GPT_SCORING=false
OPENAI_API_KEY=
GPT_MODEL=gpt-4o-mini

