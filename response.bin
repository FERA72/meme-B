  	width: calc(33.33% - 40px);
    min-width: 275px;
  }
  .product-item .item-link:hover{
    text-decoration: none;
  }
  .product-item .item-title{
  	font-size: 22px;
    font-weight: bold;
    display: block;
    margin: 10px 0 5px 0;
    color: #384248;
  }
  .product-item .item-title:hover{
  	color: #0587D4;
  }
  .product-item .item-description{
  	font-size: 16px;
    color: #384248;
    display: block;
  }
  .product-icon{
  	border-radius: 4px;
    font-size: 24px;
    height: 40px;
    width: 40px;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .icon-red{
  	background: linear-gradient(180deg,#f17c81 0,#e95f6a 100%);
  }
  .icon-green{
  	background: linear-gradient(180deg,#59d4a4 0,#12ca93 100%);
  }
  .icon-yellow{
  	background: linear-gradient(180deg,#ffd885 0,#f7c543 100%);
  }
  .icon-blue{
  	background: linear-gradient(180deg,#619efe 0,#118cfd 100%);
  }
  .icon-purple{
  	background: linear-gradient(180deg,#9987c9 0,#8470be 100%);
  }
  .icon-orange{
  	background: linear-gradient(180deg,#ffaa7b 0,#fe8c4e 100%);
  }
  .icon-gray{
  	background: linear-gradient(180deg,#adb4c1 0,#939eae 100%);
  }
  
  @media(prefers-color-scheme: dark){
